{
  "name": "@versionone/agility-sdk",
  "version": "1.0.0-alpha.5",
  "description": "TypeScript SDK for the Digital.ai Agility (VersionOne) API: queries, batches, schema-translated rows, guarded writes, attachments",
  "keywords": [
    "agility",
    "digital.ai",
    "versionone",
    "v1",
    "sdk",
    "api-client",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "dev": "tsup --watch",
    "download:metamodel": "node scripts/download-metamodel.mjs",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:types": "node scripts/generate-types.mjs",
    "test:integration": "node scripts/run-integration.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "rimraf": "^6.0.1",
    "tsup": "^9.0.0",
    "typescript": "^5.8.2",
    "vitest": "^5.1.0"
  },
  "volta": {
    "node": "24.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/versionone/VersionOne.SDK.JavaScript.git"
  },
  "homepage": "https://github.com/versionone/VersionOne.SDK.JavaScript#readme",
  "bugs": {
    "url": "https://github.com/versionone/VersionOne.SDK.JavaScript/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
