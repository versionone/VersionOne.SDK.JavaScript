{
  "name": "@versionone/sdk",
  "version": "0.1.0",
  "description": "Minimal TypeScript SDK starter for digital.ai Agility APIs",
  "keywords": [
    "sdk",
    "typescript",
    "api-client"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "dev": "tsup --watch",
    "download:metamodel": "node scripts/download-metamodel.mjs",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:types": "node scripts/generate-types.mjs",
    "test:integration": "node scripts/run-integration.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "volta": {
    "node": "24.14.0"
  }
}
